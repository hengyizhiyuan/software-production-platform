# Local development values only. Do not reuse them outside local/test environments.
SPG_DATABASE_URL=postgresql+psycopg://spg:spg-local-dev@127.0.0.1:54329/spg_dev?sslmode=disable&connect_timeout=5
SPG_TEST_DATABASE_URL=postgresql+psycopg://spg:spg-local-dev@127.0.0.1:54329/spg_test?sslmode=disable&connect_timeout=5
# Shared DeepSeek credential and endpoint. Keep the real value in ignored .env.
# SPG_DEEPSEEK_API_KEY=<DeepSeek API key>
# SPG_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Human collaboration profiles remain independent of Executor policy.
# SPG_WIC_PROVIDER_ADAPTER=deepseek
# SPG_WIC_PROVIDER_MODEL=deepseek-flash
# SPG_CONVERSATION_PROVIDER_ADAPTER=deepseek
# SPG_CONVERSATION_PROVIDER_MODEL=deepseek-flash
# Set both efforts alike to keep eligible native pre-Work on one model call.
# Leaving one unset while setting the other selects two sequential calls.
# These are experiment examples, not a measured universal speed recommendation.
# SPG_WIC_PROVIDER_REASONING_EFFORT=low
# SPG_CONVERSATION_PROVIDER_REASONING_EFFORT=low
# SPG_COLLABORATION_PROVIDER_TIMEOUT_SECONDS=120
# SPG_COLLABORATION_PROVIDER_MAX_OUTPUT_TOKENS=8192
# SPG_WIC_COALESCE_PRE_WORK=false  # opt out of eligible pre-Work single-call transport
# LEGACY_WIC, WIC_VNEXT_SHADOW, or explicit WIC_VNEXT_CONTROLLED.
# SPG_WIC_RUNTIME_MODE=WIC_VNEXT_SHADOW

# Watt-native Executor Provider Worker. It reuses SPG_DEEPSEEK_API_KEY while
# keeping its exact model and reasoning policy independent from WIC.
# SPG_NATIVE_EXECUTOR_INTERNAL_TOKEN=<dedicated random Tool Host token>
# SPG_NATIVE_EXECUTOR_INFERENCE_PROVIDER=deepseek
# SPG_NATIVE_EXECUTOR_INFERENCE_MODEL=deepseek-flash
# SPG_NATIVE_EXECUTOR_INFERENCE_REASONING_EFFORT=high
# SPG_NATIVE_EXECUTOR_SELF_REFINE_ATTEMPT_BUDGET=3
# SPG_NATIVE_EXECUTOR_SAME_FAILURE_THRESHOLD=2
# SPG_NATIVE_EXECUTOR_SELF_REFINE_TIME_BUDGET_SECONDS=300
# SPG_NATIVE_EXECUTOR_SELF_REFINE_INFERENCE_BUDGET=12
# SPG_NATIVE_EXECUTOR_SELF_REFINE_TOKEN_BUDGET=20000
